  "dependencies": {
    "fastify": "^5.8.5",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
